{
  "name": "@nimiq/web3-provider-nimiq",
  "version": "4.0.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.es.js",
  "unpkg": "dist/index.umd.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.es.js"
    }
  },
  "contributors": [
    "Trust <support@trustwallet.com>",
    "The Nimiq Development Team <info@nimiq.com>"
  ],
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build:clean": "rm -rf dist",
    "build:types": "tsc",
    "build:source": "bun build:clean && rollup --config ./rollup.config.js && bun run build:types",
    "dev": "bun build ./index.ts --outdir ./dist --watch"
  },
  "dependencies": { },
  "devDependencies": {
    "@trustwallet/web3-provider-core": "workspace:*"
  }
}
